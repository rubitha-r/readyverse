# ===================================================
# ReadyVerse AI Server & Provider Router Configuration
# ===================================================

# Primary AI Provider (Default: 'gemini' for Realtime Voice & Text)
AI_PRIMARY_PROVIDER=gemini

# Fallback AI Provider (Default: 'groq' for High-Speed LPU Text Backup)
AI_FALLBACK_PROVIDER=groq

# Server Port (Default: 3000)
PORT=3000

# ---------------------------------------------------
# Google Gemini Configuration (PRIMARY REALTIME VOICE)
# ---------------------------------------------------
# Google AI Studio Gemini API Key (Get from https://aistudio.google.com)
# Format: AIzaSy...
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live Native Audio Model (Default: models/gemini-2.0-flash-exp)
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp

# Gemini Text & Chat Fallback Model (Default: gemini-2.0-flash)
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Default Voice for Gemini Live Companion (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE=Puck

# ---------------------------------------------------
# Groq LPU Configuration (BACKUP FAST TEXT CONVERSATION)
# ---------------------------------------------------
# Groq Cloud API Key (Get from https://console.groq.com/keys)
# Format: gsk_...
GROQ_API_KEY=your_groq_api_key_here

# Groq High-Speed Conversational Model (Default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------
# Development & Failover Testing Switches
# ---------------------------------------------------
# Set to 'true' to simulate primary Gemini outage and verify seamless Groq failover
AI_FAILOVER_TEST=false

# ---------------------------------------------------
# OpenAI Configuration (OPTIONAL / COMPATIBILITY)
# ---------------------------------------------------
# OpenAI API Key (Format: sk-proj-... or sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Realtime Voice Model (Default: gpt-4o-realtime-preview)
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# OpenAI Chat Fallback Model (Default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Default Voice for OpenAI Companion (alloy, echo, shimmer, ash, ballad, coral, sage, verse)
OPENAI_VOICE=alloy
